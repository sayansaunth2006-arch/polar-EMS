# ============================================================
# POLAR-EMS environment configuration
# Copy this file to .env (backend) and frontend/.env.local (frontend)
# and fill in real values. Never commit the real .env files.
# ============================================================

# --- Backend (FastAPI) ---
# PostgreSQL connection string. Works with local Postgres, Supabase, or any
# managed Postgres provider. Falls back to a local SQLite file automatically
# if unset, so the API can still be run with zero external setup.
DATABASE_URL=postgresql+psycopg2://polar_ems:polar_ems_dev_password@localhost:5432/polar_ems

# Secret used to sign JWT access tokens. Generate a real random value for
# any non-local deployment, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-in-production-dev-only-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# Optional: real weather API key. If unset, the weather service falls back
# to a deterministic synthetic polar-weather simulator.
WEATHER_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
